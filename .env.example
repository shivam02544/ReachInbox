# ==========================================
# ReachInbox Email Scheduler Environment Configuration
# ==========================================

# ------------------------------------------
# 1. Infrastructure & Core Services
# ------------------------------------------
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://reachinbox_user:reachinbox_pass@postgres:5432/reachinbox_db?schema=public

# PostgreSQL Database Configuration
POSTGRES_USER=reachinbox_user
POSTGRES_PASSWORD=reachinbox_pass
POSTGRES_DB=reachinbox_db

# Redis Cache & Queue Storage Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Frontend Service URL
FRONTEND_URL=http://localhost:3000

# ------------------------------------------
# 2. Worker & Scheduling Configuration
# ------------------------------------------
WORKER_CONCURRENCY=5
MAX_RECIPIENTS_PER_REQUEST=1000
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=100
MAX_CSV_FILE_SIZE_MB=5

# ------------------------------------------
# 3. Ethereal SMTP Mailer Credentials (Step 3)
# ------------------------------------------
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=ethereal_user_placeholder
ETHEREAL_PASSWORD=ethereal_password_placeholder
ETHEREAL_SECURE=false

# ------------------------------------------
# 4. Authentication & Security Configuration (Step 5)
# ------------------------------------------
# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_placeholder
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Session Security
SESSION_TTL_SECONDS=86400
SESSION_SECRET=placeholder_do_not_commit_real_secret
