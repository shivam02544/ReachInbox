// Prisma Schema Definition for ReachInbox Email Scheduler

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// System initialization model for Prisma setup & dependency health check
model SystemInit {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}
