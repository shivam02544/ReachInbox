{
  "name": "reachinbox-backend",
  "version": "1.0.0",
  "description": "ReachInbox Email Scheduler Backend API and Worker Foundation",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker": "ts-node src/worker.ts",
    "worker:prod": "node dist/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:db:push": "prisma db push",
    "db:seed": "ts-node prisma/seed.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@types/nodemailer": "^6.4.17",
    "bullmq": "5.21.2",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "ioredis": "5.4.1",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "20.17.6",
    "nodemon": "3.1.7",
    "prisma": "5.22.0",
    "ts-node": "10.9.2",
    "typescript": "5.6.3"
  }
}
